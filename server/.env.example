# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/municipal-complaints

# JWT secrets (use strong random values in production)
JWT_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production

# Admin registration access code
# Required for creating admin users; keep this secret and share only with trusted staff.
ADMIN_ACCESS_CODE=change_this_admin_access_code

# Application base URL (frontend URL used in emails)
# Example: https://civicconnect.example.com
APP_BASE_URL=http://localhost:5173

# SMTP / email settings
# Configure these with your email provider (e.g. SendGrid, SES, custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="CivicConnect <no-reply@example.com>"

# Cloudinary configuration for complaint images
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Priority AI: optional LLM (Gemini) for better priority + reason; fallback is TF.js
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key

# TF.js fallback: if USE_TEST_DATA=true, uses test_data.csv; else municipal_complaints_training.csv
USE_TEST_DATA=true
